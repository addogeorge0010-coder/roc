generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum DonationMethod {
  MOBILE_MONEY
  CARD
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  neonAuthId    String?        @unique @map("neon_auth_id")
  name          String
  email         String         @unique
  passwordHash  String?        @map("password_hash")
  role          Role           @default(MEMBER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  notifyAnnouncements  Boolean            @default(true) @map("notify_announcements")
  notifySermons        Boolean            @default(true) @map("notify_sermons")
  announcements        Announcement[]
  donations            Donation[]
  departments          Department[]
  announcementLikes    AnnouncementLike[]
  announcementComments AnnouncementComment[]
  savedSermons         SermonSave[]
  pushTokens           PushToken[]

  @@map("users")
}

model Department {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  members       User[]
  announcements Announcement[]

  @@map("departments")
}

model Announcement {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  content      String      @db.Text
  authorId     String      @map("author_id") @db.Uuid
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  likes        AnnouncementLike[]
  comments     AnnouncementComment[]

  @@index([createdAt(sort: Desc)])
  @@index([departmentId])
  @@map("announcements")
}

model AnnouncementLike {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([announcementId])
  @@map("announcement_likes")
}

model AnnouncementComment {
  id             String       @id @default(uuid()) @db.Uuid
  content        String       @db.Text
  userId         String       @map("user_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  author         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
  @@map("announcement_comments")
}

model Sermon {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  youtubeVideoId String       @map("youtube_video_id")
  datePreached   DateTime     @map("date_preached")
  createdAt      DateTime     @default(now()) @map("created_at")
  saves          SermonSave[]

  @@index([datePreached(sort: Desc)])
  @@map("sermons")
}

model SermonSave {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sermonId  String   @map("sermon_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sermon    Sermon   @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([userId, sermonId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("sermon_saves")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Donation {
  id                   String         @id @default(uuid()) @db.Uuid
  amount               Decimal        @db.Decimal(12, 2)
  userId               String?        @map("user_id") @db.Uuid
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  method               DonationMethod
  status               DonationStatus @default(PENDING)
  transactionReference String         @unique @map("transaction_reference")
  createdAt            DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("donations")
}
