NODE_ENV=development
PORT=4000

# Neon Postgres. Use the pooled URL for application traffic and the direct
# (unpooled) URL for Prisma Migrate.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_SCHEMA="public"

# Neon Auth (Managed Better Auth) base URL and JWKS for the linked branch.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Signs the short-lived session_data cookie. 32+ characters.
NEON_AUTH_COOKIE_SECRET="replace-with-openssl-rand-base64-32"

# "*" allows any origin. For web clients, use a comma-separated allowlist.
CORS_ORIGIN="*"

# Used by `npm run db:seed`
SEED_ADMIN_NAME="Ama Mensah"
SEED_ADMIN_EMAIL="admin@rpc.church"
SEED_ADMIN_PASSWORD="Admin123!"
