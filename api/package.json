{
  "name": "rpc-church-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Royal Palace Chapel Assemblies of God mobile app",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:setup": "prisma migrate deploy && prisma generate && prisma db seed",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.5",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@better-auth/core": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/telemetry": "1.7.12",
    "@better-fetch/fetch": "1.3.2",
    "better-auth": "1.7.12",
    "better-call": "1.4.4"
  }
}
